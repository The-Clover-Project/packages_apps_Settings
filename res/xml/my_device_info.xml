<PreferenceScreen
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:settings="http://schemas.android.com/apk/res-auto"
    android:key="my_device_info_pref_screen"
    android:title="@string/about_settings">

    <com.android.settingslib.widget.LayoutPreference
        android:key="about_phone_branding"
        android:layout="@layout/about_phone_brand_card"
        android:selectable="false"/>

    <com.android.settingslib.widget.LayoutPreference
        android:key="about_phone_meta_pills"
        android:layout="@layout/about_phone_meta_pills"
        android:selectable="false"/>

    <PreferenceCategory
        android:key="about_phone_device_overview_category"
        android:title="@string/about_phone_device_overview_section_title">

        <com.android.settingslib.widget.LayoutPreference
            android:key="about_phone_info_cards"
            android:layout="@layout/about_phone_info_cards"
            android:selectable="false"/>
    </PreferenceCategory>

    <PreferenceCategory
        android:key="basic_info_category"
        android:title="@string/about_phone_basic_info_section_title"
        android:selectable="false">

        <Preference
            android:key="clover_maintainer"
            android:order="5"
            android:icon="@drawable/accessible_forward_24px"
            android:title="@string/clover_maintainer"
            android:summary="@string/summary_placeholder"
            settings:enableCopying="true"/>

        <!-- Accounts -->
        <Preference
            android:key="branded_account"
            android:order="10"
            android:icon="@drawable/group_24px"
            android:title="@string/account_settings_title"
            android:summary="@string/summary_placeholder"
            settings:enableCopying="true"
            settings:controller="com.android.settings.deviceinfo.BrandedAccountPreferenceController"/>

        <!-- Build number -->
        <Preference
            android:key="build_number"
            android:order="15"
            android:icon="@drawable/ic_build_24px"
            android:title="@string/build_number"
            android:summary="@string/summary_placeholder"
            settings:enableCopying="true"
            settings:controller="com.android.settings.deviceinfo.BuildNumberPreferenceController"/>

        <Preference
            android:key="more_device_info"
            android:order="20"
            android:icon="@drawable/info_24px"
            android:title="@string/about_phone_more_device_info_title"
            android:fragment="com.android.settings.deviceinfo.aboutphone.MoreDeviceInfoFragment"
            android:widgetLayout="@layout/about_phone_more_device_info_widget"/>
    </PreferenceCategory>

</PreferenceScreen>
